#!/bin/sh

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-utf8.ps1
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-utf8.ps1
else
  echo "Commit bloqueado: PowerShell não encontrado para validar UTF-8."
  exit 1
fi
